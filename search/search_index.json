{"config":{"lang":["zh"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Alex \u7684\u77e5\u8bc6\u5e93","text":"<p>\u8bb0\u5f55\u548c\u6c89\u6dc0\u5de5\u4f5c\u4e2d\u9047\u5230\u7684\u6280\u672f\u6807\u51c6\u4e0e\u653f\u7b56\u6cd5\u89c4\uff0c\u65b9\u4fbf\u968f\u65f6\u67e5\u9605\u3002</p>"},{"location":"#_1","title":"\u77e5\u8bc6\u5e93\u76ee\u5f55","text":""},{"location":"#3gpp-uas","title":"\ud83d\udce1 3GPP UAS","text":"<p>3GPP \u65e0\u4eba\u673a\u7cfb\u7edf\uff08Unmanned Aircraft System\uff09\u76f8\u5173\u6807\u51c6\uff1a\u4e1a\u52a1\u9700\u6c42\u3001\u7cfb\u7edf\u67b6\u6784\u3001\u7a7a\u53e3\u589e\u5f3a\u7b49\u3002</p> <ul> <li>\u603b\u89c8 \u2014 UAS \u5728 3GPP \u4e2d\u7684\u6574\u4f53\u56fe\u666f</li> <li>\u5173\u952e\u89c4\u8303\u6e05\u5355 \u2014 TS / TR \u7f16\u53f7\u901f\u67e5</li> </ul>"},{"location":"#_2","title":"\ud83d\udea8 \u5e94\u6025\u653f\u7b56","text":"<p>\u5e94\u6025\u7ba1\u7406\u76f8\u5173\u653f\u7b56\u6cd5\u89c4\u4e0e\u9884\u6848\u4f53\u7cfb\u3002</p> <ul> <li>\u603b\u89c8 \u2014 \u5e94\u6025\u7ba1\u7406\u4f53\u7cfb\u6846\u67b6</li> <li>\u6cd5\u5f8b\u6cd5\u89c4 \u2014 \u76f8\u5173\u6cd5\u5f8b\u3001\u6761\u4f8b\u3001\u9884\u6848\u6e05\u5355</li> </ul>"},{"location":"#_3","title":"\u4f7f\u7528\u8bf4\u660e","text":"<ul> <li>\u53f3\u4e0a\u89d2\u641c\u7d22\u6846\u652f\u6301\u4e2d\u6587\u5168\u6587\u68c0\u7d22</li> <li>\u5185\u5bb9\u6301\u7eed\u6574\u7406\u4e2d\uff0c\u6761\u76ee\u6807\u6ce8\u300c\u5f85\u8865\u5145\u300d\u7684\u8868\u793a\u8fd8\u6ca1\u5199\u5b8c</li> <li>\u6240\u6709\u9875\u9762\u90fd\u662f Markdown\uff0c\u6539\u8d77\u6765\u5f88\u65b9\u4fbf</li> </ul>"},{"location":"about/","title":"\u5173\u4e8e","text":"<p>\u8fd9\u662f Alex \u7684\u4e2a\u4eba\u77e5\u8bc6\u5e93\uff0c\u4e3b\u8981\u6c89\u6dc0 3GPP UAS\uff08\u65e0\u4eba\u673a\u901a\u4fe1\u6807\u51c6\uff09 \u4e0e\u5e94\u6025\u653f\u7b56\u4e24\u65b9\u9762\u7684\u5b66\u4e60\u7b14\u8bb0\u3002</p>"},{"location":"about/#_2","title":"\u672c\u7ad9\u5982\u4f55\u7ef4\u62a4","text":"<ul> <li>\u6240\u6709\u5185\u5bb9\u90fd\u662f Markdown \u6587\u4ef6\uff0c\u653e\u5728 <code>docs/</code> \u76ee\u5f55\u4e0b</li> <li>\u65b0\u589e\u9875\u9762\uff1a\u5728 <code>docs/</code> \u4e0b\u5efa <code>.md</code> \u6587\u4ef6\uff0c\u5e76\u5728 <code>mkdocs.yml</code> \u7684 <code>nav</code> \u91cc\u52a0\u4e0a\u5165\u53e3</li> <li>\u672c\u5730\u9884\u89c8\uff1a<code>mkdocs serve</code>\uff0c\u6d4f\u89c8\u5668\u6253\u5f00 http://127.0.0.1:8000</li> <li>\u91cd\u65b0\u90e8\u7f72\uff1a<code>mkdocs gh-deploy</code>\uff08\u63a8\u9001\u5230 GitHub Pages\uff09</li> </ul>"},{"location":"3gpp-uas/","title":"3GPP UAS \u603b\u89c8","text":"<p>\u72b6\u6001\uff1a\u6574\u7406\u4e2d \ud83d\udea7 \u2014\u2014 \u6982\u5ff5\u6027\u5185\u5bb9\u5df2\u6838\u5bf9\uff0c\u7ec6\u8282\u5f85\u8865\u5145</p>"},{"location":"3gpp-uas/#uas","title":"UAS \u662f\u4ec0\u4e48","text":"<p>UAS\uff08Unmanned Aircraft System\uff0c\u65e0\u4eba\u673a\u7cfb\u7edf\uff09\u6307\u7531\u65e0\u4eba\u673a\uff08UAV\uff09\u53ca\u5176\u76f8\u5173\u63a7\u5236\u7ad9\u3001\u6570\u636e\u94fe\u7b49\u7ec4\u6210\u7684\u5b8c\u6574\u7cfb\u7edf\u30023GPP \u4ece R15/R16 \u5f00\u59cb\u7814\u7a76\u8702\u7a9d\u7f51\u7edc\u5982\u4f55\u4e3a\u65e0\u4eba\u673a\u63d0\u4f9b\u8fde\u63a5\uff0c\u628a\u65e0\u4eba\u673a\u5f53\u4f5c\u4e00\u79cd\u7279\u6b8a\u7684\u7ec8\u7aef\uff08Aerial UE\uff09\u6765\u652f\u6301\u3002</p>"},{"location":"3gpp-uas/#3gpp-uas_1","title":"3GPP \u4e3a\u4ec0\u4e48\u8981\u505a UAS","text":"<p>\u8702\u7a9d\u7f51\u7edc\u7ed9\u65e0\u4eba\u673a\u5e26\u6765\u51e0\u7c7b\u5173\u952e\u80fd\u529b\uff1a</p> <ul> <li>C2 \u901a\u4fe1\uff08Command and Control\uff09\uff1a\u98de\u63a7\u6307\u4ee4\u94fe\u8def\uff0c\u8981\u6c42\u4f4e\u65f6\u5ef6\u3001\u9ad8\u53ef\u9760</li> <li>Remote ID\uff08\u8fdc\u7a0b\u8bc6\u522b\uff09\uff1a\u65e0\u4eba\u673a\u5411\u76d1\u7ba1\u65b9\u5e7f\u64ad/\u4e0a\u62a5\u8eab\u4efd\u4e0e\u4f4d\u7f6e\uff0c\u6ee1\u8db3\u5404\u56fd\u7a7a\u57df\u7ba1\u7406\u8981\u6c42</li> <li>USS \u5bf9\u63a5\uff08UAS Service Supplier\uff09\uff1a3GPP \u7f51\u7edc\u4e0e\u65e0\u4eba\u673a\u670d\u52a1\u63d0\u4f9b\u65b9\u4e92\u901a\uff0c\u505a\u822a\u7ebf\u5ba1\u6279\u3001\u7a7a\u57df\u6388\u6743</li> <li>\u8bc6\u522b\u4e0e\u8ffd\u8e2a\uff1a\u7f51\u7edc\u4fa7\u5bf9\u65e0\u4eba\u673a\u8eab\u4efd\u7684\u8bc6\u522b\u3001\u4f4d\u7f6e\u8ffd\u8e2a\u80fd\u529b</li> </ul>"},{"location":"3gpp-uas/#_1","title":"\u6807\u51c6\u6f14\u8fdb\u8109\u7edc","text":"\u9636\u6bb5 \u5185\u5bb9 R16 TR 22.829 \u7acb\u9879\u7814\u7a76\uff1aUAS \u8fde\u63a5\u3001\u8bc6\u522b\u4e0e\u8ffd\u8e2a\u7684\u53ef\u884c\u6027 R17 TS 22.125 \u53d1\u5e03\u4e1a\u52a1\u9700\u6c42\uff1bTS 23.256 \u5b9a\u4e49 5G \u7cfb\u7edf\u67b6\u6784\u652f\u6301 R17 \u53ca\u4ee5\u540e \u7a7a\u53e3\u589e\u5f3a\u3001\u7f51\u7edc\u5207\u7247/ QoS \u4fdd\u969c\u3001C2 \u94fe\u8def\u53ef\u9760\u6027\u6301\u7eed\u6f14\u8fdb <p>\u7248\u672c\u8bf4\u660e</p> <p>\u5177\u4f53\u89c4\u8303\u4ee5 3GPP \u5b98\u7f51 \u53d1\u5e03\u7248\u672c\u4e3a\u51c6\uff0c\u672c\u9875\u4e3a\u5b66\u4e60\u7b14\u8bb0\u6027\u8d28\u7684\u68b3\u7406\u3002</p>"},{"location":"3gpp-uas/specs/","title":"\u5173\u952e\u89c4\u8303\u6e05\u5355","text":"<p>\u72b6\u6001\uff1a\u6574\u7406\u4e2d \ud83d\udea7 \u2014\u2014 \u7f16\u53f7\u4e0e\u6807\u9898\u5df2\u6838\u5bf9\uff0c\u5177\u4f53\u7ae0\u8282\u7ec6\u8282\u5f85\u8865\u5145</p> \u89c4\u8303\u7f16\u53f7 \u6807\u9898 \u9636\u6bb5 \u8bf4\u660e TR 22.829 Study on supporting UAS connectivity, Identification and tracking R16 \u7814\u7a76 UAS \u53ef\u884c\u6027\u7814\u7a76\uff0c\u9700\u6c42\u7684\u6e90\u5934 TS 22.125 Unmanned Aerial System (UAS) support in 3GPP R17 \u4e1a\u52a1\u9700\u6c42 Stage 1\uff1aUAS \u4e1a\u52a1\u4e0e KPI \u9700\u6c42 TS 23.256 Support of Uncrewed Aerial Systems (UAS) connectivity, identification and tracking R17 \u7cfb\u7edf\u67b6\u6784 Stage 2\uff1a5GS \u5982\u4f55\u652f\u6301 UAS\uff0c\u542b USS \u5bf9\u63a5 TR 36.777 Study on Enhanced LTE Support for Aerial Vehicles R15 \u7814\u7a76 LTE \u670d\u52a1\u7a7a\u4e2d\u7ec8\u7aef\u7684\u7a7a\u53e3\u7814\u7a76\u62a5\u544a"},{"location":"3gpp-uas/specs/#_2","title":"\u5f85\u8865\u5145","text":"<ul> <li>[ ] R18/R19 UAS \u76f8\u5173\u589e\u5f3a\uff08C2 \u53ef\u9760\u6027\u3001\u5b9a\u4f4d\u589e\u5f3a\u7b49\uff09</li> <li>[ ] \u5404\u89c4\u8303\u6838\u5fc3\u7ae0\u8282\u6458\u5f55</li> <li>[ ] Remote ID \u4e0e ASTM F3411 \u7684\u5bf9\u5e94\u5173\u7cfb</li> </ul>"},{"location":"emergency/","title":"\u5e94\u6025\u653f\u7b56\u603b\u89c8","text":"<p>\u72b6\u6001\uff1a\u6574\u7406\u4e2d \ud83d\udea7 \u2014\u2014 \u6846\u67b6\u6027\u5185\u5bb9\u5df2\u6838\u5bf9\uff0c\u7ec6\u8282\u5f85\u8865\u5145</p>"},{"location":"emergency/#_2","title":"\u5e94\u6025\u7ba1\u7406\u4f53\u7cfb\u6846\u67b6","text":"<p>2018 \u5e74\u7ec4\u5efa\u5e94\u6025\u7ba1\u7406\u90e8\uff0c\u6574\u5408\u4e86\u539f\u5c5e\u591a\u90e8\u95e8\u7684\u5e94\u6025\u7ba1\u7406\u3001\u5b89\u5168\u751f\u4ea7\u76d1\u7ba1\u3001\u6d88\u9632\u3001\u6551\u707e\u3001\u5730\u8d28\u707e\u5bb3\u9632\u6cbb\u7b49\u804c\u8d23\uff0c\u5f62\u6210\u7edf\u4e00\u7684\u5e94\u6025\u7ba1\u7406\u4f53\u7cfb\u3002</p>"},{"location":"emergency/#_3","title":"\u300c\u4e00\u6848\u4e09\u5236\u300d","text":"<p>\u6211\u56fd\u5e94\u6025\u7ba1\u7406\u4f53\u7cfb\u5efa\u8bbe\u7684\u7ecf\u5178\u6982\u62ec\uff1a</p> <ul> <li>\u4e00\u6848\uff1a\u5e94\u6025\u9884\u6848\u4f53\u7cfb</li> <li>\u4e09\u5236\uff1a\u5e94\u6025\u7ba1\u7406\u4f53\u5236\u3001\u673a\u5236\u3001\u6cd5\u5236</li> </ul>"},{"location":"emergency/#_4","title":"\u9884\u6848\u4f53\u7cfb","text":"<ul> <li>\u56fd\u5bb6\u603b\u4f53\u5e94\u6025\u9884\u6848</li> <li>\u4e13\u9879\u5e94\u6025\u9884\u6848\uff08\u5982\u9632\u6c5b\u6297\u65f1\u3001\u5730\u9707\u3001\u5371\u5316\u54c1\u7b49\uff09</li> <li>\u90e8\u95e8\u5e94\u6025\u9884\u6848</li> <li>\u5730\u65b9\u5e94\u6025\u9884\u6848\uff08\u7701\u3001\u5e02\u3001\u53bf\u4e09\u7ea7\uff09</li> <li>\u4f01\u4e8b\u4e1a\u5355\u4f4d\u5e94\u6025\u9884\u6848</li> </ul>"},{"location":"emergency/#_5","title":"\u7a81\u53d1\u4e8b\u4ef6\u5206\u7ea7","text":"<p>\u6309\u4e25\u91cd\u7a0b\u5ea6\u4e00\u822c\u5206\u4e3a\u56db\u7ea7\uff1a\u7279\u522b\u91cd\u5927\uff08\u2160\u7ea7\uff09\u3001\u91cd\u5927\uff08\u2161\u7ea7\uff09\u3001\u8f83\u5927\uff08\u2162\u7ea7\uff09\u3001\u4e00\u822c\uff08\u2163\u7ea7\uff09\u3002</p>"},{"location":"emergency/#_6","title":"\u5f85\u8865\u5145","text":"<ul> <li>[ ] \u5e94\u6025\u7ba1\u7406\u90e8\u6700\u65b0\u673a\u6784\u804c\u80fd\u8c03\u6574</li> <li>[ ] \u5404\u4e13\u9879\u9884\u6848\u6e05\u5355\u4e0e\u8981\u70b9</li> <li>[ ] \u5e94\u6025\u901a\u4fe1\u4fdd\u969c\u76f8\u5173\u653f\u7b56</li> </ul>"},{"location":"emergency/laws/","title":"\u6cd5\u5f8b\u6cd5\u89c4\u6e05\u5355","text":"<p>\u72b6\u6001\uff1a\u6574\u7406\u4e2d \ud83d\udea7 \u2014\u2014 \u540d\u5f55\u5df2\u6838\u5bf9\uff0c\u6761\u6587\u8981\u70b9\u5f85\u8865\u5145</p>"},{"location":"emergency/laws/#_2","title":"\u6cd5\u5f8b","text":"\u540d\u79f0 \u8bf4\u660e \u7a81\u53d1\u4e8b\u4ef6\u5e94\u5bf9\u6cd5 \u5e94\u6025\u7ba1\u7406\u9886\u57df\u7684\u57fa\u7840\u6027\u6cd5\u5f8b\uff1b2024 \u5e74\u4fee\u8ba2\uff0c2024 \u5e74 11 \u6708 1 \u65e5\u8d77\u65bd\u884c \u5b89\u5168\u751f\u4ea7\u6cd5 \u751f\u4ea7\u5b89\u5168\u9886\u57df\u57fa\u672c\u6cd5\uff0c\u591a\u6b21\u4fee\u8ba2 \u6d88\u9632\u6cd5 \u6d88\u9632\u5de5\u4f5c\u65b9\u9488\u3001\u8d23\u4efb\u4e0e\u76d1\u7763 \u9632\u9707\u51cf\u707e\u6cd5 \u5730\u9707\u76d1\u6d4b\u9884\u62a5\u3001\u707e\u5bb3\u9884\u9632\u4e0e\u5e94\u6025\u6551\u63f4 \u9632\u6d2a\u6cd5 \u9632\u6d2a\u89c4\u5212\u3001\u8bbe\u65bd\u5efa\u8bbe\u4e0e\u8c03\u5ea6 \u6c14\u8c61\u6cd5 \u6c14\u8c61\u63a2\u6d4b\u3001\u9884\u62a5\u9884\u8b66\u4e0e\u707e\u5bb3\u9632\u5fa1"},{"location":"emergency/laws/#_3","title":"\u884c\u653f\u6cd5\u89c4 / \u6761\u4f8b","text":"<ul> <li>\u7a81\u53d1\u516c\u5171\u536b\u751f\u4e8b\u4ef6\u5e94\u6025\u6761\u4f8b</li> <li>\u751f\u4ea7\u5b89\u5168\u4e8b\u6545\u5e94\u6025\u6761\u4f8b</li> <li>\u81ea\u7136\u707e\u5bb3\u6551\u52a9\u6761\u4f8b</li> <li>\u5371\u9669\u5316\u5b66\u54c1\u5b89\u5168\u7ba1\u7406\u6761\u4f8b</li> </ul>"},{"location":"emergency/laws/#_4","title":"\u9884\u6848","text":"<ul> <li>\u56fd\u5bb6\u7a81\u53d1\u4e8b\u4ef6\u603b\u4f53\u5e94\u6025\u9884\u6848</li> <li>\u56fd\u5bb6\u9632\u6c5b\u6297\u65f1\u5e94\u6025\u9884\u6848</li> <li>\u56fd\u5bb6\u5730\u9707\u5e94\u6025\u9884\u6848</li> <li>\u56fd\u5bb6\u7a81\u53d1\u516c\u5171\u4e8b\u4ef6\u533b\u7597\u536b\u751f\u6551\u63f4\u5e94\u6025\u9884\u6848</li> </ul>"},{"location":"emergency/laws/#_5","title":"\u5f85\u8865\u5145","text":"<ul> <li>[ ] \u6bcf\u90e8\u6cd5\u89c4\u7684\u6838\u5fc3\u6761\u6b3e\u6458\u5f55</li> <li>[ ] \u4fee\u8ba2\u52a8\u6001\u8ddf\u8e2a\uff08\u5982\u7a81\u53d1\u4e8b\u4ef6\u5e94\u5bf9\u6cd5 2024 \u4fee\u8ba2\u8981\u70b9\uff09</li> </ul>"}]}